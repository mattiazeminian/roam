EXPO_PUBLIC_MAPBOX_TOKEN=

# Routing credentials (#63). Prefer the proxy so no provider secret ships in the
# app bundle. Set EXPO_PUBLIC_ORS_PROXY_URL to the deployed proxy base URL; the
# client then calls `${EXPO_PUBLIC_ORS_PROXY_URL}/directions/foot-walking/geojson`
# and sends no key. See docs/ors-proxy.md.
EXPO_PUBLIC_ORS_PROXY_URL=

# OpenRouteService direct key — local development only. Free key from
# https://openrouteservice.org/dev/#/signup. Anything with the EXPO_PUBLIC_
# prefix is embedded in the bundle, so this must not be used in a release build.
# Used only when EXPO_PUBLIC_ORS_PROXY_URL is unset.
EXPO_PUBLIC_ORS_API_KEY=
