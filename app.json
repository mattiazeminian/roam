{
  "expo": {
    "name": "Roam",
    "slug": "roam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mattiazeminian.roam",
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.mattiazeminian.roam"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-lockup-light.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0E0F0C",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-image-picker",
        {
          "photosPermission": "ROAM uses your photo library only when you choose a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ROAM uses your location to find running routes near you.",
          "locationAlwaysAndWhenInUsePermission": "ROAM keeps recording your run when the screen is off or ROAM is in the background.",
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
